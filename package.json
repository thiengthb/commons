{
  "name": "@thiengthb/commons",
  "version": "0.1.0",
  "private": true,
  "description": "The fleet's shared registry — installable UI, helpers, scripts and configs (copy-in, no runtime dependency).",
  "type": "module",
  "scripts": {
    "registry:build": "shadcn build",
    "validate": "shadcn registry validate",
    "readme": "node scripts/gen-readme.mjs && prettier --write README.md --log-level warn",
    "readme:check": "node scripts/gen-readme.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "shadcn": "latest"
  }
}
